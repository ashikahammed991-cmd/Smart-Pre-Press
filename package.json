{
  "name": "smart-pre-press",
  "version": "1.4.0",
  "description": "Smart Pre-Press editable artboard prototype with artboard management, editable overlay objects, CSV/XLSX merge and basic UPS layout",
  "main": "main.js",
  "author": "Smart Pre-Press",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.smartprepress.app",
    "productName": "Smart Pre-Press",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5",
    "jszip": "^3.10.1",
    "jspdf": "^3.0.1",
    "pdfjs-dist": "3.11.174"
  }
}
