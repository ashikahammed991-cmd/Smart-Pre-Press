{
  "name": "Smart Pre-Press",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "postCreateCommand": "npm install",
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": { "label": "Smart Pre-Press (web preview)", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["tauri-apps.tauri-vscode", "rust-lang.rust-analyzer", "dbaeumer.vscode-eslint"]
    }
  }
}
